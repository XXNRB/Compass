# ============================================================================
# Schedulo backend - Environment variables
# Copy this file and replace placeholders with real values.
# Never commit secrets; .env is listed in .gitignore.
# ============================================================================


# --- Server ---
# Port the Express API listens on (default: 3000)
PORT=3000


# Runtime mode: "development" for local dev, "production" when deployed
NODE_ENV=development


# --- Google Calendar OAuth ---
# OAuth 2.0 client ID from Google Cloud Console
GOOGLE_CLIENT_ID=799705900671-qgsbgo7vi59hd89irevj3iipio5ocf7t.apps.googleusercontent.com


# OAuth 2.0 client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=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


# Callback URL registered in Google Cloud (must match exactly)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


# --- Microsoft Outlook OAuth ---
# Application (client) ID from Azure App Registration
MICROSOFT_CLIENT_ID=48cb886a-f81e-4fa3-999a-a2912a974871


# Client secret value from Azure App Registration
MICROSOFT_CLIENT_SECRET=67l8Q~V~X7rA3Q6imPPlzCdpGmTOSIuLc~e1Acd9


# Azure AD tenant ID ("common" for multi-tenant, or your tenant GUID)
MICROSOFT_TENANT_ID=10bcafce-4728-4a8d-a6df-afca02916ca7


# Redirect URI registered in Azure (must match exactly)
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback


